# U-EventTrack Production Environment Configuration
# This file contains production settings for Hostinger deployment

# Application
APP_NAME="U-EventTrack"
APP_ENV=production
APP_KEY=base64:Ga3DJbwHUFn0MQV5xfmxS6aXoHbRJoVuAmIOLf4ijrY=
APP_DEBUG=false
APP_URL=https://ueventtrack.online
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Database Configuration (Hostinger MySQL)
DB_CONNECTION=mysql
DB_HOST=srv1416.hstgr.io
DB_PORT=3306
DB_DATABASE=u501626207_kyle
DB_USERNAME=u501626207_magsino
DB_PASSWORD=Kylethegreat#1

# Cache Configuration
CACHE_STORE=database
CACHE_PREFIX=ueventtrack_cache

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ueventtrack.online
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue Configuration
QUEUE_CONNECTION=database

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Broadcasting (Disabled)
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local

# Mail Configuration (Optional - configure if using email)
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@ueventtrack.online"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (Not used in this setup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (Not used in this setup)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=ueventtrack.online,localhost:3000
SANCTUM_GUARD=web

# CORS Configuration
FRONTEND_URL=https://ueventtrack.online

# Google OAuth (Optional - configure if using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ueventtrack.online/api/auth/google/callback

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true

# Fine Calculation Settings
FINE_AMOUNT_PER_ABSENCE=50
FINE_CALCULATION_ENABLED=true

# Event Settings
EVENT_AUTO_STATUS_UPDATE=true
EVENT_ANNOUNCEMENT_SYNC=true

# Security Settings
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Rate Limiting
THROTTLE_REQUESTS=60
THROTTLE_DECAY_MINUTES=1

# Telescope (Debugging - Disable in production)
TELESCOPE_ENABLED=false

# Debugbar (Disable in production)
DEBUGBAR_ENABLED=false

# Trusted Proxies
TRUSTED_PROXIES=*

# Asset URL (for CDN if needed)
ASSET_URL=
