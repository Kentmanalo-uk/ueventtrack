# EAS Build Ignore File
# Files and directories to exclude from the EAS build upload

# Backend folder (not needed for mobile app build)
../backend/**

# Frontend folder (not needed for mobile app build)  
../frontend/**

# Node modules
node_modules/**

# Git
.git/**
../.git/**

# IDE
.vscode/**
.idea/**

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
*.apk
*.aab
*.ipa

# Temporary files
*.tmp
*.temp
.tmp/**
.temp/**
