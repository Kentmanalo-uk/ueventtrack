{
  "expo": {
    "name": "UEvent",
    "slug": "uevent",
    "owner": "emnl1215s-team",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/usg-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/usg-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan barcodes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./android/app/src/main/res/xml/network_security_config.xml"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to scan barcodes for event attendance."
      },
      "bundleIdentifier": "com.emnl2004.USG_app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/usg-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.emnl2004.USG_app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "networkSecurityConfig": "./android/app/src/main/res/xml/network_security_config.xml"
    },
    "scheme": "com.emnl2004.USG_app",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8be05b3b-b770-4b84-b109-e24ec5ddb8dd"
      }
    }
  }
}
